                      <button
                        type="button"
                        onClick={() => setHasLeader("no")}
                        className={`p-3 rounded-xl border text-xs font-bold text-center cursor-pointer transition-colors ${
                          hasLeader === "no"
                            ? "bg-zinc-900 text-white border-zinc-900"
                            : "bg-zinc-50 text-zinc-700 border-zinc-200"
                        }`}
                      >
