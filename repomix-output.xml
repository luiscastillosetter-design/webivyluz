                    </label>
                    <select
                      value={howFound}
                      onChange={(e) => setHowFound(e.target.value)}
                      className="w-full rounded-xl border border-zinc-200 bg-white p-3 text-xs text-zinc-800 outline-none focus:border-zinc-900"
                    >
                      <option value="">Selecciona una opción</option>
